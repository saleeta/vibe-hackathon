  InputLines:
    - '// @input string hand = "right" {"hint":"Which hand to track for curls — \"left\" or \"right\"."}'
    - '// @input SceneObject headAnchor {"hint":"Anchor approximating head/camera height (e.g. the world camera object)."}'
    - '// @input float curledHeightThreshold = -20 {"hint":"Index-tip height relative to the head anchor (cm) to count as \"curled\". Captured curl up-swings cross well above -20 (peaks -9..-17) while still tracked; the fully-held-up pose itself is out of the tracking volume, so this is a pass-through crossing, not an endpoint."}'
    - '// @input float extendedHeightThreshold = -45 {"hint":"Index-tip height relative to the head anchor (cm) to count as \"extended\". Captured down-swings reliably cross -45 while tracked (they bottom out -50..-66 but tracking often drops before then), so -45 not -60."}'
    - '// @input float curlTimeoutMs = 4000 {"hint":"If stuck in the \"curled\" state longer than this (ms) — usually because the hand went out of the tracking volume at the top of a rep — silently reset to \"extended\" so the counter does not jam. No rep is counted."}'
    - "// @input float curlWeightKg = 5 {\"hint\":\"Weight being curled, in kg — Spectacles can't sense actual load, so this is manual. Keep in sync with WorkoutManager.curlWeightKg.\"}"
    - '// @input float heightSmoothing = 0.35 {"hint":"Smoothing factor for relativeHeight, 0-1. Higher = more responsive, noisier. Filters out single-frame tracking spikes."}'
    - '// @input float trackingSettleMs = 300 {"hint":"Ignore readings for this many ms right after the hand is (re)acquired — the first tracked position after acquisition is frequently garbage/stale."}'
    - '// @input float trackingGraceMs = 400 {"hint":"If tracking drops for less than this many ms, hold the curl state instead of resetting — a curl routinely nudges the hand past the FOV edge mid-rep. Longer gaps are treated as a real loss (re-settle on re-acquire)."}'
    - '// @input float diagnosticIntervalMs = 500 {"hint":"How often (ms) to print a diagnostic line with the live wrist height while tuning. 0 disables."}'
    - "// @input SceneObject handDebugMarker {\"hint\":\"Optional — a plain 3D Text (no ScreenTransform) pinned live to the tracked hand's actual world position, showing the live numbers. Lets you visually check whether the tracked point is really where your hand is.\"}"
    - // @input Component.Text handDebugText
    - "// @input SceneObject headDebugMarker {\"hint\":\"Optional — a plain 3D Text pinned to the head anchor's world position, for the same visual sanity check.\"}"
    - // @input Component.Text headDebugText
