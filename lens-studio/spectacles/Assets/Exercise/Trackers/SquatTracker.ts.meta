  InputLines:
    - '// @input float dipThresholdCm = 18 {"hint":"How far below the standing baseline (cm) counts as a squat. Walking only dips ~7 cm; a real squat is 40+ cm. 18 leaves margin for an imperfect baseline."}'
    - '// @input float returnMarginCm = 12 {"hint":"Once dipped, must rise back within this many cm of the baseline to count as \"returned to standing\". 12 tolerates a few cm of baseline drift."}'
    - '// @input float maxSquatMs = 9000 {"hint":"Only if the dip is held longer than this (ms) is it treated as a sit (no rep, re-sample baseline on standing up). Set generously — even a slow controlled squat rep is well under 9 s; a sit is 10 s+."}'
    - '// @input float calibrationDelayMs = 1500 {"hint":"Delay after onAwake before sampling the standing baseline height, ms."}'
    - '// @input float diagnosticIntervalMs = 1000 {"hint":"How often (ms) to print a diagnostic line with the live baseline / height / dip / state while tuning. 0 disables."}'
